# Binance API Credentials
# Copy this file to .env and insert your Binance API credentials
# Ensure your API key has "Enable Spot & Margin Trading" checked
# DO NOT enable "Enable Withdrawals" for bot safety!

BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# Trading Settings
DEFAULT_SYMBOL=ETH/USDT
DEFAULT_TIMEFRAME=1h
